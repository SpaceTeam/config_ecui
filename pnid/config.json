	"rocket_state_machine": {
		"states": [
            "fuel_rocket:sensor",
            "ox_rocket:sensor"
        ],
        "eval": "if (parseInt(inVars['value']) >= 0 && parseInt(inVars['value']) < stateMachines['full'].length) { outVars['value'] = stateMachines['full'][parseInt(inVars['value'])]; outVars['color'] = 'good' } else { outVars['value'] = 'Unknown State (' + inVars['value'] + ')'; outVars['color'] = 'unknown' }; if (parseInt(inVars['value']) == 0) { outVars['color'] = 'neutral' } else if (parseInt(inVars['value']) == 7) { outVars['color'] = 'bad' }"
	},
	"decoupler": {
	    "states": [
	        "ox_decoupler:sensor"
	    ],
	    "eval": "if (inVars['value'] >= thresholds['solenoid']['high']) { outVars['color']='connected'; outVars['value']='Powered (' + inVars['value'] + ')' } else { outVars['color']='disconnected'; outVars['value']='Unpowered (' + inVars['value'] + ')' }",
        "sens_deviation": "if ((setState == 0 && feedback >= thresholds['solenoid']['high']) || (setState == 1 && feedback < thresholds['solenoid']['high'])) { return true; } return false;",
	    "popup": [
            {
                "type": "display",
                "style": "text"
            },
            {
                "type": "input",
                "style": "checkbox"
            }
        ]
    },
	"decoupler_feedback": {
	    "states": [
	        "ox_decoupler_feedback:sensor"
	    ],
	    "eval": "if (inVars['value'] >= thresholds['solenoid']['high']) { outVars['color']='off'; outVars['value']='Disconnected' } else { outVars['color']='on'; outVars['value']='Connected' }",
	    "popup": [
            {
                "type": "display",
                "style": "text"
            },
            {
                "type": "input",
                "style": "checkbox"
            }
        ]
    },
	"retract": {
	    "states": [
	        "retract:sensor"
	    ],
	    "eval": "",
        "popup": [
            {
                "type": "input",
