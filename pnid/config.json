        ],
        "eval": "if (inVars['value'] >= thresholds['chamberPressure']['high']) { outVars['color']='high' } else if (inVars['value'] >= thresholds['chamberPressure']['low']) { outVars['color']='neutral' } else if (inVars['value'] > 2) { outVars['color']='high' } else { outVars['color']='low' }"
    },
