        "eval": "if (inVars['value'] >= 450) { outVars['color']='open'; outVars['value']='Open (' + inVars['value'] + ')' } else { outVars['color']='closed'; outVars['value']='Closed (' + inVars['value'] + ')' }",
        "sens_deviation": "if ((setState == 0 && feedback >= 450) || (setState == 1 && feedback < 450)) { return true; } return false;"
    },
