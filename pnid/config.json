        "eval": "if (inVars['value'] >= 2.5) { outVars['color']='high'; } else if (inVars['value'] >= 1.1) { outVars['color']='neutral'; } else { outVars['color']='low' }"
    },
    "dewar_press_solenoid": {
        "states": [
            "dewar_pressurize_solenoid:sensor"
