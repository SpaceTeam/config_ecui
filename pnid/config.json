	"holddown": {
        "states": [
            "holddown:sensor"
        ],
        "eval": "if (inVars['value'] >= thresholds['solenoid']['high']) { outVars['color']='open'; outVars['value']='Release' } else { outVars['color']='closed'; outVars['value']='Hold' }",
        "popup": [
            {
                "type": "display",
                "style": "text"
            },
            {
                "type": "input",
                "style": "checkbox",
                "variable": "holddown-sensor"
            }
        ]
	},
	"umbilical_retract": {
        "states": [
            "umbilical_retract:sensor"
        ],
        "eval": "if (inVars['value'] >= thresholds['motor']['high']) { outVars['color']='open'; outVars['value']='Retract' } else { outVars['color']='closed'; outVars['value']='Stop' }"
	},
	"safety_light": {
        "states": [
            "gui:safety_light"
        ],
        "popup": [
