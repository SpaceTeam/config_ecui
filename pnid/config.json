            }
        ]
    },
	"charging": {
	    "states": [
	        "ox_sense_12V:sensor"
	    ],
	    "eval": "if (inVars['value'] > 15) { outVars['color']='battery_critical' } else if (inVars['value'] >= 13) { outVars['color']='battery_charging'; } else if (inVars['value'] >= 10) { outVars['color']='battery_nominal'; } else { outVars['color']='battery_critical'; }",
        "popup": [
            {
                "type": "input",
                "style": "checkbox",
                "variable": "battery_charging-sensor",
                "label": "Disable Charge"
            }
        ]
    },
