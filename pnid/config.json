                "label": "Reset"
            },
            {
                "type": "input",
                "style": "buttonDanger",
                "variable": "safety_light:SetDanger",
                "label": "Danger"
            },
            {
                "type": "input",
                "style": "button",
                "variable": "safety_light:SetSafe",
                "label": "Safe"
            }
        ]
	},
	"safety_light_red": {
        "states": [
            "gse_elec_bob_lamp_red:sensor"
        ],
        "eval": "if (inVars['value'] < thresholds['light']['high']) { outVars['color'] = 'off'; outVars['value'] = '' } else { outVars['color'] = 'error'; outVars['value'] = 'Danger' }",
        "sens_deviation": "return false;"
	},
	"safety_light_green": {
        "states": [
            "gse_elec_bob_lamp_green:sensor"
        ],
        "eval": "if (inVars['value'] < thresholds['light']['high']) { outVars['color'] = 'off'; outVars['value'] = '' } else { outVars['color'] = 'success'; outVars['value'] = 'Safe' }",
        "sens_deviation": "return false;"
	},
